# Copy to backend/.env for local development. Every value is optional:
# without any of them the project still runs against a local Postgres
# database "msg" and a local Redis.
DATABASE_URL=postgres://postgres@localhost:5432/msg
REDIS_URL=rediscache://localhost:6379/1
# DJANGO_SECRET_KEY=
# SENTRY_DSN=
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_VERIFY_SERVICE_SID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
